{
  "$defs": {
    "JsonValue": {},
    "State": {
      "description": "Lifecycle state shared by Trace, Span and Envelope.",
      "enum": [
        "open",
        "closed"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "description": "One request, from the first service that handled it to the last.",
  "properties": {
    "attributes": {
      "description": "Mutable trace-level state written by the control plane or a consumer.",
      "patternProperties": {
        "^[a-z0-9_]+(\\.[a-z0-9_]+)*$": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "title": "Attributes",
      "type": "object"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "metadata": {
      "description": "Trace labels.",
      "patternProperties": {
        "^[a-z0-9_]+(\\.[a-z0-9_]+)*$": {
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional human label.",
      "title": "Name"
    },
    "schema_version": {
      "default": "0.2",
      "description": "Schema version, major.minor.",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "$ref": "#/$defs/State"
    },
    "trace_id": {
      "description": "Trace id: 32 lowercase hex characters, not all zeros.",
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "state"
  ],
  "title": "Trace",
  "type": "object"
}
